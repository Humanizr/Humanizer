{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@site/*": [
        "./*"
      ]
    },
    "skipLibCheck": true,
    "target": "ES2022",
    "strict": true
  },
  "exclude": [
    ".docusaurus",
    "build"
  ]
}
